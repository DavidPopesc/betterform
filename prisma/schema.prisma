// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
}

// Application models for BetterForm: accounts, forms, fields, responses
// Notes:
// - Store form schemas in `Json` for flexible field sets (Values.json).
// - Sensitive values (TOTP secrets, per-field values) should be encrypted
//   at the application layer before writing to the DB.

enum FieldType {
  short_text
  paragraph
  multiple_choice
  checkboxes
  dropdown
  file_upload
  number
  email
  phone
  linear_scale
  rating
  date
  time
  multiple_choice_grid
  checkbox_grid
}

model Account {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  // TOTP / 2FA
  totpEnabled   Boolean  @default(false)
  totpSecret    String?  // encrypted ciphertext (store encrypted at app layer)
  totpVerifiedAt DateTime?
  recoveryCodes Json?    // array of hashed recovery codes

  // relations
  forms              Form[]
  sessions           Session[]
  emailVerifications EmailVerification[]
  loginApprovals     LoginApproval[]
  passwordResets     PasswordReset[]
  authEvents         AuthEvent[]
  // WebAuthn / Passkeys
  passkeys           PasskeyCredential[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Form {
  id        String      @id @default(uuid())
  publicId  String      @unique @default(uuid()) // public sharing ID, different from internal ID
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String?

  // full schema for the form (Values.json-like structure)
  schema    Json

  // Theme & customization
  theme     String      @default("blue")

  // Quiz mode settings
  isQuiz    Boolean     @default(false)
  showScore Boolean     @default(false)

  // Success message customization
  successMessage String  @default("Your response has been recorded.")

  // Response restrictions
  responsesEnabled   Boolean     @default(true)
  responseDeadline   DateTime?
  oneResponsePerEmail Boolean    @default(false)
  oneResponsePerUser  Boolean    @default(false)

  // API integration settings
  apiEnabled Boolean @default(false)
  apiKey     String? @unique // Deprecated, keeping for backward compatibility
  submissionApiKey String? @unique
  dataApiKey       String? @unique
  webhookUrl String?

  // optional normalized field rows for queries / admin tooling
  fields    FormField[]
  responses Response[]
  emailVerifications EmailVerificationRecord[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model FormField {
  id        String    @id @default(uuid())
  formId    String
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  name      String
  label     String
  type      FieldType
  required  Boolean   @default(false)
  order     Int       @default(0)
  validation Json?    // e.g. { min:0, max:120, pattern: "..." }
  settings  Json?     // UI / upload settings, options etc.
  encrypt   Boolean   @default(false) // whether this field should be encrypted
}

model Response {
  id             String      @id @default(uuid())
  formId         String
  form           Form        @relation(fields: [formId], references: [id], onDelete: Cascade)

  // The entire submission payload (keyed by field names). Encrypt per-field values
  // at the application layer when necessary.
  response       Json

  createdAt      DateTime    @default(now())
  respondentIp   String?     // store as string; consider hashing before persist
  respondentHash String?     // app-level hashed identifier (HMAC)
  respondentEmail String?    // for quick lookup/indexing
  formAccountId  String?     // tracks which form account submitted this

  processed      Boolean     @default(false)
  attachments    Attachment[]

  @@index([formId, createdAt])
  @@index([respondentEmail])
}

model Attachment {
  id         String   @id @default(uuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String?
  size       Int?
  url        String   // e.g., S3 URL or storage key
  createdAt  DateTime @default(now())
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store only a hash of the opaque session token for lookup
  tokenHash  String   @unique

  // Device / client metadata
  deviceName String?  // friendly device label (e.g. "David's iPhone")
  ip         String?  // IPv4/IPv6 as string (consider hashing if stored long-term)
  userAgent  String?
  geo        Json?    // optional geo data (country, region) resolved server-side

  // Usage / lifecycle
  createdAt  DateTime @default(now())
  lastSeen   DateTime?
  expiresAt  DateTime?
  revoked    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id         String   @id @default(uuid())
  userId     String
  user       Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store only hash of the token
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
}

model LoginApproval {
  id         String   @id @default(uuid())
  userId     String
  user       Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String   @unique
  approved   Boolean  @default(false)
  rejected   Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  approvedAt DateTime?
  rejectedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id         String   @id @default(uuid())
  userId     String
  user       Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
}

model AuthEvent {
  id        String   @id @default(uuid())
  userId    String?  // may be null for failed attempts
  user      Account? @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   // e.g. "login_success", "login_failure", "refresh", "revoke"
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PasskeyCredential {
  id           String   @id @default(uuid())
  userId       String
  user         Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The raw credential ID produced by the authenticator (base64)
  credentialId String   @unique

  // Stored credential public key (base64) for verifying assertions
  publicKey    String

  // Stored signature counter from the authenticator
  signCount    Int      @default(0)

  // Entire attestation/metadata stored as JSON for later verification/insight
  metadata     Json?

  transports   String[]   @default([])

  createdAt    DateTime @default(now())

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String?
  // base64 challenge sent to client
  challenge String
  type      String   // 'registration' | 'assertion'
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model FormAccountUUID {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  lastSeen         DateTime @updatedAt
  ipAddresses      Json     @default("[]")
  deviceMetrics    Json?
  verifiedEmails   String[] @default([])
  verifiedPhones   String[] @default([])
  formsViewed      Json     @default("[]")
  formsSubmitted   Json     @default("[]")
}

model EmailVerificationRecord {
  id              String   @id @default(uuid())
  formId          String
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  email           String
  formAccountId   String
  tokenHash       String   @unique
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  
  @@index([formId, email])
  @@index([formAccountId])
}
