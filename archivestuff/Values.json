        {
            "schemaVersion": 1,
            "fields": [
                {
                    "id": "f1",
                    "name": "name",
                    "label": "Name",
                    "type": "short_text",
                    "required": true,
                    "order": 0,
                    "validation": { "maxLength": 200 },
                    "placeholder": "Full name"
                },
                {
                    "id": "f2",
                    "name": "age",
                    "label": "Age",
                    "type": "number",
                    "required": true,
                    "order": 1,
                    "validation": { "min": 0, "max": 120 }
                },
                {
                    "id": "f3",
                    "name": "phone_number",
                    "label": "Phone number",
                    "type": "short_text",
                    "required": false,
                    "order": 2,
                    "validation": { "pattern": "^[0-9\\-+() ]{7,}$" },
                    "encrypt": true
                },
                {
                    "id": "f4",
                    "name": "email",
                    "label": "Email",
                    "type": "email",
                    "required": false,
                    "order": 3,
                    "encrypt": true
                },
                {
                    "id": "f5",
                    "name": "comments",
                    "label": "Comments",
                    "type": "paragraph",
                    "required": true,
                    "order": 4
                },
                {
                    "id": "f6",
                    "name": "ip_address",
                    "label": "IP Address (telemetry)",
                    "type": "short_text",
                    "required": false,
                    "order": 5,
                    "notes": "telemetry - consider hashing/encrypting",
                    "encrypt": true
                },
                {
                    "id": "f7",
                    "name": "satisfaction",
                    "label": "Satisfaction",
                    "type": "linear_scale",
                    "required": false,
                    "order": 6,
                    "validation": { "min": 1, "max": 5 }
                },
                {
                    "id": "f8",
                    "name": "favorite_fruit",
                    "label": "Favorite fruit",
                    "type": "multiple_choice",
                    "required": false,
                    "order": 7,
                    "options": [
                        { "value": "apple", "label": "Apple" },
                        { "value": "banana", "label": "Banana" },
                        { "value": "orange", "label": "Orange" }
                    ]
                },
                {
                    "id": "f9",
                    "name": "attachments",
                    "label": "Attachments",
                    "type": "file_upload",
                    "required": false,
                    "order": 8,
                    "settings": {
                        "maxFiles": 3,
                        "maxSizeMB": 20,
                        "allowedMimeTypes": ["image/png", "image/jpeg", "application/pdf"],
                        "store": "s3"
                    }
                }
            ]
        }